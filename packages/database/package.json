{
  "name": "@custom-os-ota/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/with-root-env.mjs prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "node ../../scripts/with-root-env.mjs prisma generate",
    "db:migrate": "node ../../scripts/with-root-env.mjs prisma migrate dev",
    "db:push": "node ../../scripts/with-root-env.mjs prisma db push",
    "db:seed": "node ../../scripts/with-root-env.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@custom-os-ota/configuration": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
