# Application
NODE_ENV=development
DATABASE_URL=postgresql://ota:change-me@localhost:5432/ota
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
CSRF_SECRET=generate-with-openssl-rand-base64-32

# OTA
OTA_PUBLIC_BASE_URL=https://release.mod-syria.org/
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_QUARANTINE=ota-quarantine
S3_BUCKET_PUBLISHED=ota-published
OTA_MAX_PACKAGE_BYTES=8589934592

# Rollout / logging
ROLLOUT_HASH_SECRET=generate-with-openssl-rand-base64-32
LOG_LEVEL=info
ACCESS_LOG_RETENTION_DAYS=90
