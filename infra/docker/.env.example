# Docker Compose — copy to .env (never commit .env)

POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin

# App secrets (npm run generate-env fills these — min 32 chars for *_SECRET)
AUTH_SECRET=change-me-run-generate-env
CSRF_SECRET=change-me-run-generate-env
ROLLOUT_HASH_SECRET=change-me-run-generate-env

# Public URLs
OTA_PUBLIC_BASE_URL=https://release.mod-syria.org/
S3_PUBLIC_ENDPOINT=https://release.mod-syria.org/s3

# Max OTA package size (bytes). Default 8 GiB.
OTA_MAX_PACKAGE_BYTES=8589934592
S3_FORCE_PATH_STYLE=true

# Scale without Kubernetes
DASHBOARD_REPLICAS=1
WORKER_REPLICAS=2
WORKER_CONCURRENCY=2

HTTP_PORT=80
HTTPS_PORT=443

# Pinned MinIO images (immutable digest — update deliberately after testing)
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727

# GHCR images (build: scripts/docker-build-push.ps1 -Push)
DASHBOARD_IMAGE=ghcr.io/kkh95x/ota-update-server-dashboard:latest
WORKER_IMAGE=ghcr.io/kkh95x/ota-update-server-worker:latest
