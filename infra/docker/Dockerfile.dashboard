# syntax=docker/dockerfile:1
# Build context MUST be the monorepo root (not infra/docker):
#   docker build -f infra/docker/Dockerfile.dashboard -t ghcr.io/kkh95x/ota-update-server-dashboard:latest .
# Or from infra/docker:  powershell -File build.ps1

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
RUN pnpm install --frozen-lockfile --ignore-scripts || pnpm install --ignore-scripts

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/scripts ./scripts
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc ./
ENV DATABASE_URL=postgresql://ota:ota@postgres:5432/ota
ENV REDIS_URL=redis://redis:6379
ENV AUTH_SECRET=docker-build-auth-secret-minimum-32-characters
ENV CSRF_SECRET=docker-build-csrf-secret-minimum-32-characters
ENV OTA_PUBLIC_BASE_URL=https://release.mod-syria.org/
ENV S3_ENDPOINT=http://minio:9000
ENV S3_PUBLIC_ENDPOINT=https://release.mod-syria.org/s3
ENV S3_ACCESS_KEY_ID=minioadmin
ENV S3_SECRET_ACCESS_KEY=minioadmin
ENV ROLLOUT_HASH_SECRET=docker-build-rollout-secret-minimum-32-ch
RUN printf 'DATABASE_URL=postgresql://ota:ota@postgres:5432/ota\n' > .env
RUN pnpm --filter @custom-os-ota/database exec prisma generate
RUN pnpm --filter "@custom-os-ota/dashboard..." run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
RUN addgroup -S ota && adduser -S ota -G ota
COPY --from=builder /app/apps/dashboard/.next/standalone ./
COPY --from=builder /app/apps/dashboard/.next/static ./apps/dashboard/.next/static
USER ota
EXPOSE 3000
CMD ["node", "apps/dashboard/server.js"]
